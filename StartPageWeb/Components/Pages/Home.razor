@using StartPageWeb.Components.Handler
@using StartPageWeb.Components.Models;
@using StartPageWeb.Components.Enums;
@page "/"

<PageTitle>StartPage</PageTitle>

@if (_startPage == null)
{
    <MudContainer Fixed="true" Class="d-flex flex-row gap-4" Style="height: 75vh">
        <MudContainer Class="flex-1" Style="height: 100%">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Style="height: 100%"></MudSkeleton>
        </MudContainer>
        <MudContainer Class="flex-1" Style="height: 100%">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Style="height: 100%"></MudSkeleton>
        </MudContainer>
        <MudContainer Class="flex-1" Style="height: 100%">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Style="height: 100%"></MudSkeleton>
        </MudContainer>
        <MudContainer Class="flex-1" Style="height: 100%">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Style="height: 100%"></MudSkeleton>
        </MudContainer>
    </MudContainer>
}
else
{
    <MudDropContainer 
        T="RenderColumnEntry" 
        Items="_startPage.Entries" 
        ItemsSelector="@((item, dropzone) => item.ColumnId == dropzone)"
        ItemDropped="ItemUpdated"
        ItemPicked="ItemPicked"
        Class="d-flex flex-row justify-space-around gap-4">
        <ChildContent>
            @foreach (RenderColumn column in _startPage.Columns)
            {
                <MudDropZone 
                    T="RenderColumnEntry" 
                    Identifier="@column.Identifier" 
                    AllowReorder="true"
                    Class="flex-1">
                </MudDropZone>
            }
        </ChildContent>
        <ItemRenderer>
            @if (context.Type == ColumnEntryType.Bookmarks)
            {
                <MudPaper Class="pa-4 my-4">
                    <MudText Typo="Typo.h6">@context.Title</MudText>
                </MudPaper>
            }
            else if (context.Type == ColumnEntryType.Notes)
            {
                <MudPaper Class="pa-4 my-4">
                    <MudText Typo="Typo.h6">@context.Title</MudText>
                    @if (!_dragActiv)
                    {
                        <MudDivider DividerType="DividerType.FullWidth" Style="margin-bottom: 4px"></MudDivider>
                        <MudMarkdown Value="@context.Markdown" />
                    }
                </MudPaper>
            }
        </ItemRenderer>
    </MudDropContainer>
}


@code
{
    private bool _dragActiv = false;
    
    private RenderStartPage? _startPage =  StartPageHandler.GetMainStartPage()?.GetRenderComponents();

    private void ItemPicked()
    {
        _dragActiv = true;
    }
    
    private void ItemUpdated(MudItemDropInfo<RenderColumnEntry> dropItem)
    {
        _dragActiv = false;
        
        if (dropItem.Item == null)
        {
            return;
        }
        
        dropItem.Item.ColumnId = dropItem.DropzoneIdentifier;
        dropItem.Item.Index = dropItem.IndexInZone;
    }
}
